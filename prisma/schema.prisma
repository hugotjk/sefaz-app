// Schema do banco (Postgres - Supabase)
// Rode `npx prisma migrate dev` depois de configurar DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Como a API do PDV não expõe "Gestor" (Contato) nem "Tipo Loja" no cadastro
// de lojas, guardamos esse mapeamento aqui mesmo — você atribui uma vez por
// loja (lojaId vem da API do PDV) e o relatório usa isso pra agrupar.
// OBS: substituído pelo mapeamento automático via EmpresaLoja/GrupoLoja
// (a rota /api/lojas agora resolve Tipo Loja e Grupo Loja pela filial da API do PDV).
model LojaConfig {
  lojaId    Int      @id // mesmo Id retornado por GET /api/public/lojas
  nome      String? // NomeFantasia, só pra facilitar exibição na tela de config
  gestor    String?
  tipoLoja  String?
  updatedAt DateTime @updatedAt
}

// A API do PDV só retorna o código numérico de "Empresa" (que usamos como
// Tipo Loja) e "Grupo" (que usamos como Grupo Loja) na filial. Estas duas
// tabelas traduzem código -> nome. Populadas por scripts/seed-empresa-grupo.ts.
model EmpresaLoja {
  codigo Int    @id
  nome   String
}

model GrupoLoja {
  codigo Int    @id
  nome   String
}

// Dados de filial (Empresa/Grupo/Supervisor) sincronizados do PDV — evita a
// rota /api/lojas fazer uma chamada obterFilial() por loja (~860) ao vivo.
// Populado por syncFiliais (cursor em SyncState "filiais:cursor").
model FilialSync {
  lojaId     Int      @id
  nome       String?
  empresaId  Int?
  grupoId    Int?
  supervisor Int?
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Sincronização do catálogo / vendas / estoque da API do PDV (Fase 1 do
// relatório de Movimentação Resumida). O relatório consulta SÓ estas tabelas,
// nunca a API do PDV ao vivo (catálogo com ~130k produtos, estoque gigante).
// ---------------------------------------------------------------------------

model Produto {
  id                   String   @id // Id do produto na API do PDV
  redeId               Int
  nome                 String?
  referenciaFornecedor String?
  fornecedorId         String?
  fornecedorNome       String?
  modeloId             String?
  modeloNome           String?
  colecaoId            Int?
  colecaoNome          String?
  grupoId              Int?
  grupoNome            String?
  compradorId          String?
  compradorNome        String?
  precoVarejoAtual     Decimal? @db.Decimal(14, 2)
  updatedAt            DateTime @updatedAt
  variacoes            VariacaoProduto[]

  @@index([redeId])
}

model VariacaoProduto {
  id        String   @id // Id da variação na API do PDV
  produtoId String
  produto   Produto  @relation(fields: [produtoId], references: [id])
  redeId    Int
  updatedAt DateTime @updatedAt

  @@index([produtoId])
}

// Detalhe de vendas — SÓ os últimos ~12 meses. `consolidarVendasAntigas`
// varre pra VendaResumoMensal e apaga daqui o que passa de 12 meses.
model VendaItemSync {
  id         String   @id // ${VendaId}-${SequencialItem} (determinístico, idempotente)
  variacaoId String
  lojaId     Int
  dataHora   DateTime
  quantidade Decimal  @db.Decimal(14, 3)
  valor      Decimal  @db.Decimal(14, 2) // Preco * Quantidade (líquido, já com desconto se fizer sentido)
  createdAt  DateTime @default(now())

  @@index([variacaoId])
  @@index([lojaId])
  @@index([dataHora])
}

// Vendas com mais de 12 meses, agregadas por mês (variacao x loja x anoMes).
model VendaResumoMensal {
  variacaoId      String
  lojaId          Int
  anoMes          String // formato "2025-03"
  quantidadeTotal Decimal  @db.Decimal(14, 3)
  valorTotal      Decimal  @db.Decimal(14, 2)
  updatedAt       DateTime @updatedAt

  @@id([variacaoId, lojaId, anoMes])
  @@index([anoMes])
}

model EstoqueVariacaoSync {
  variacaoId String
  lojaId     Int
  quantidade Decimal  @db.Decimal(14, 3)
  updatedAt  DateTime @updatedAt

  @@id([variacaoId, lojaId])
  @@index([lojaId])
}

// Preço de varejo (tabela "VAREJO") por variação. Atualizado por syncPrecos.
model PrecoVariacao {
  variacaoId String   @id
  preco      Decimal  @db.Decimal(14, 2)
  updatedAt  DateTime @updatedAt
}

// Controle de progresso da sincronização (paginação/incremental), parecido
// com o ultNSU do Certificate, mas genérico pra qualquer fonte de sync.
model SyncState {
  chave     String   @id // ex: "produtos:redeId:1", "vendas", "estoque"
  valor     String   // último cursor/data/página processado
  updatedAt DateTime @updatedAt
}

enum CertificateStatus {
  PENDING       // aguardando validação
  ACTIVE        // certificado válido, em uso
  PASSWORD_ERROR // senha informada não abriu o .pfx, precisa reenviar
  EXPIRED       // certificado venceu
}

model Certificate {
  id             String            @id @default(cuid())
  cnpj           String            @unique
  razaoSocial    String?
  fileName       String
  // Blob criptografado (AES-256-GCM) contendo JSON { pfxBase64, password }.
  // A senha precisa ficar acessível ao sistema pois é usada a cada consulta horária (mTLS),
  // por isso NUNCA fica em texto puro - só a chave mestra (ENCRYPTION_KEY, env var) consegue abrir.
  encryptedBlob  String
  iv             String
  authTag        String
  status         CertificateStatus @default(PENDING)
  lastError      String?
  // NSU: controle de paginação da distribuição de documentos da SEFAZ
  ultNSU         String            @default("000000000000000")
  maxNSU         String            @default("000000000000000")
  // se true, ainda estamos na carga inicial (histórico completo)
  backfillDone   Boolean           @default(false)
  validUntil     DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  notes          Note[]
}

enum NoteStatus {
  AUTORIZADA
  CANCELADA
  DENEGADA
  DESCONHECIDA
}

model Note {
  id            String       @id @default(cuid())
  chaveAcesso   String       @unique // chave de 44 dígitos da NFe
  cnpjDestino   String
  certificateId String
  certificate   Certificate  @relation(fields: [certificateId], references: [id])

  numero        String?
  serie         String?
  tipoOperacao  String?      // "Entrada" ou "Saída" (tpNF da nota)
  emitenteCnpj  String?
  emitenteNome  String?
  valorTotal    Decimal?     @db.Decimal(14, 2)
  dataEmissao   DateTime?
  status        NoteStatus   @default(AUTORIZADA)

  // XML completo da NFe (protocolo de autorização), como recebido da SEFAZ
  xmlCompleto   String

  nsu           String       // NSU em que este documento foi recebido
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  eventos       NoteEvent[]

  @@index([cnpjDestino])
  @@index([emitenteCnpj])
}

enum NoteEventType {
  CARTA_CORRECAO
  CANCELAMENTO
  CIENCIA_OPERACAO
  CONFIRMACAO_OPERACAO
  DESCONHECIMENTO_OPERACAO
  OPERACAO_NAO_REALIZADA
  OUTRO
}

model NoteEvent {
  id          String        @id @default(cuid())
  noteId      String
  note        Note          @relation(fields: [noteId], references: [id])
  tipo        NoteEventType
  descricao   String?
  xmlEvento   String
  nsu         String
  dataEvento  DateTime?
  createdAt   DateTime      @default(now())

  @@index([noteId])
}
